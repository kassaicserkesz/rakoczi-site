---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getAllEvents } from '../../lib/events.js';
import raw from '../../partials/index_sk.html?raw';

const SK_MON = ['','jan','feb','mar','apr','máj','jún','júl','aug','sep','okt','nov','dec'];
const fmtSk = (iso) => { const [y,m,d] = iso.split('-'); return `${d}. ${m}. ${y}`; };
const fmtLong = (ev) => {
  const [y,m,d] = ev.data.start.split('-');
  let s = ev.data.end ? `${+d}. – ${+ev.data.end.split('-')[2]}.` : `${+d}.`;
  s += ` ${SK_MON[+m]} ${y}`;
  if (ev.data.time) s += ` · ${ev.data.time}`;
  return s;
};
const plate = (ev) => {
  const [y,m,d] = ev.data.start.split('-');
  const day = ev.data.end ? `${+d}–${+ev.data.end.split('-')[2]}` : `${+d}`;
  const rng = ev.data.end ? ' dp-range' : '';
  return `<p class="date-plate"><span class="dp-month">${SK_MON[+m]}</span><span class="dp-day${rng}">${day}</span></p>`;
};
const aktCard = (b, i) => `
<article class="akt-card" data-reveal="" style="--rd:${i*110}ms">
<figure class="akt-media">${b.data.cover ? `<img src="${b.data.cover}" alt="" width="409" height="222" loading="lazy">` : '<div class="ph-cover" role="img" aria-label="Miesto pre titulnú fotku">titulná fotka</div>'}</figure>
<div class="akt-body">
<h3 class="font-display text-lg font-semibold leading-snug text-ink"><a href="/sk/galeria/${b.id}" class="akt-link">${b.data.title}</a></h3>
<p class="mt-2 text-sm text-ink/75">${(b.body||'').trim()}</p>
<p class="akt-date"><time datetime="${b.data.date}">${fmtSk(b.data.date)}</time></p>
</div>
</article>`;
const PIN = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>';
const CALI = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3.5 10.5h17"></path></svg>';
const signRow = (ev, i) => `
<article class="signpost" data-reveal="" style="--rd:${i*110}ms">
<div class="signpost-board event-row relative">
${plate(ev)}
<div class="min-w-0">
<h3 class="font-display text-lg font-semibold leading-snug text-ink"><a href="/sk/podujatia" class="event-link">${ev.data.title}</a></h3>
<p class="mt-1 text-sm text-ink/75">${(ev.body||'').trim()}</p>
<p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-[0.13em] text-ink/70">
${ev.data.place ? `<span class="inline-flex items-center gap-1.5">${PIN} ${ev.data.place}</span>` : ''}
<span class="hidden sm:inline">${fmtLong(ev)}</span>
</p>
</div>
${ev.data.ics ? `<a href="${ev.data.ics}" download class="btn-cal relative z-10 justify-self-start md:justify-self-end" title="Súbor sa otvorí v tvojom kalendári a udalosť sa uloží" aria-label="Uložiť do kalendára: ${ev.data.title}">${CALI} Do kalendára</a>` : ''}
</div>
</article>`;

const besz = (await getCollection('beszamolok')).sort((a,b)=>b.data.date.localeCompare(a.data.date)).slice(0,3);
const today = new Date().toISOString().slice(0,10);
const ese = (await getAllEvents()).filter(e=>(e.data.end||e.data.start)>=today).slice(0,3);
const main = raw
  .replace('<!--AKT-->', besz.map(aktCard).join('\n'))
  .replace('<!--SIGN-->', ese.map(signRow).join('\n'));
---
<Base title='17. skautský zbor II. Rákóczi Ferenc, Košice' desc='Maďarský skauting v Košiciach: týždenné družinovky, túry a tábory. Spoznaj náš oddiel, pridaj sa alebo nás podpor.' path='/sk/' lang='sk' pageCss="/css/index.css" alts={{"hu": "/", "sk": "/sk/", "en": "/en/"}}>
<Fragment set:html={main} />
</Base>