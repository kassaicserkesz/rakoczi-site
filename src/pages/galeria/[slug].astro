---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const all = (await getCollection('beszamolok')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
  return all.map((b, i) => ({ params: { slug: b.id }, props: { b, prev: all[i+1] ?? null, next: all[i-1] ?? null } }));
}
const { b, prev, next } = Astro.props;
const fmtHu = (iso) => { const [y,m,d] = iso.split('-'); return `${y}. ${m}. ${d}.`; };
const fmtRange = (start, end) => (end && end !== start) ? `${fmtHu(start)} – ${fmtHu(end)}` : fmtHu(start);
const PINB = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>';
const AL = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19.5 12h-15m6.5-6.5L4.5 12 11 18.5"></path></svg>';
const AR = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12h15m-6.5-6.5L19.5 12 13 18.5"></path></svg>';
const photos = b.data.photos.length ? b.data.photos : (b.data.cover ? [b.data.cover] : []);
const tiles = photos.map((p, i) => `
<button type="button" class="alb-tile" data-full="${p}" data-alt="${b.data.title}" aria-label="Fotó megnyitása (${i+1}/${photos.length})">
<img src="${p}" alt="${b.data.title}" loading="lazy" decoding="async"></button>`).join('\n');
const main = `<main id="main" tabindex="-1" class="outline-none">
<section class="relative isolate">
<div class="container-site hero-enter relative z-10 py-14 md:py-20">
<a href="/galeria" class="link-arrow">${AL} Galéria</a>
<h1 class="mt-8 max-w-3xl text-balance font-display text-2xl font-semibold text-pine md:text-3xl">${b.data.title}</h1>
<p class="alb-meta mt-5">
${b.data.place ? `<span class="ami">${PINB} ${b.data.place}</span>` : ''}
<span class="ami"><time datetime="${b.data.date}">${fmtRange(b.data.date, b.data.endDate)}</time></span>
</p>
${(b.body||'').trim() ? `<div class="article-body mt-6 max-w-3xl text-pretty text-base md:text-lg"><p>${(b.body||'').trim()}</p></div>` : ''}
</div>
</section>
<section class="border-t border-sand/40">
<div class="container-site py-14 md:py-20">
<div class="alb-grid" data-reveal="">
${tiles}
</div>
<div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-sand/40 pt-8">
${next ? `<a href="/galeria/${next.id}" class="link-arrow">${AL} ${next.data.title}</a>` : '<span></span>'}
${prev ? `<a href="/galeria/${prev.id}" class="link-arrow">${prev.data.title} ${AR}</a>` : ''}
</div>
</div>
</section>
</main>
<div id="lb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Fotó nagyban">
<button type="button" id="lb-close" class="lb-btn lb-close" aria-label="Bezárás"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg></button>
<img id="lb-img" class="lb-img" src="" alt="">
<div id="lb-bar" class="lb-bar">
<button type="button" id="lb-prev" class="lb-btn" aria-label="Előző fotó"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 6-6 6 6 6"></path></svg></button>
<span id="lb-count" class="lb-count" aria-live="polite"></span>
<button type="button" id="lb-next" class="lb-btn" aria-label="Következő fotó"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 6 6 6-6 6"></path></svg></button>
</div>
</div>`;
---
<Base title={`${b.data.title} | Galéria – 17.sz. II. Rákóczi Ferenc cserkészcsapat`} desc={(b.body||'').trim() || b.data.title} path={`/galeria/${b.id}`} pageCss="/css/galeria-oszi-tanyazas-2025.css" pageJs="/js/galeria-oszi-tanyazas-2025.js" alts={{ hu: `/galeria/${b.id}`, sk: `/sk/galeria/${b.id}`, en: `/en/gallery/${b.id}` }}>
<Fragment set:html={main} />
</Base>